# Vertex AI (ADC) configuration — no API key required

# GCP project used for Vertex AI and BigQuery
GOOGLE_CLOUD_PROJECT=brainrot-453319

# Vertex GenAI region (must be a region, not "global"). Common: us-central1 or europe-west1
GOOGLE_CLOUD_LOCATION=us-central1

# BigQuery dataset (fully qualified: project.dataset)
BIGQUERY_DATASET=bigquery-public-data.thelook_ecommerce

# BigQuery location (US, EU, or the dataset's region)
BIGQUERY_LOCATION=US

# Path to your local LookML repo
LOOKML_REPO_PATH=./data/lookml

# Caching and runtime behavior
ENABLE_CACHE=true
CACHE_DIR=./data/cache
ENABLE_DRY_RUN=false
DEFAULT_LIMIT=100
LOG_LEVEL=INFO

# Force LLM planner on (default true)
USE_LLM_PLANNER=true

# Critical: enable Vertex (API-key mode is disabled when this is true)
GOOGLE_GENAI_USE_VERTEXAI=true
